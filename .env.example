# Vizor Environment Configuration
#
# Copy this file to `.env` (local) and set the same keys in your host's
# environment settings for production. Every var must be prefixed with VITE_
# to be exposed to the client bundle. All of these are OPTIONAL — the app runs
# fully client-side and works without any of them.

# --- Supabase (optional: cloud projects / templates / data sources) ---
# Get these from your Supabase project settings at https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- PostHog analytics (optional) ---
# The app reads VITE_POSTHOG_KEY (VITE_POSTHOG_API_KEY is also accepted).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# --- Sentry error monitoring (optional) ---
VITE_SENTRY_DSN=
